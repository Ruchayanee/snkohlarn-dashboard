<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Dashboard สรุปรายได้ | SN Kohlarn</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;500&display=swap" rel="stylesheet">
    <style>body { font-family: 'Kanit', sans-serif; }</style>
</head>
<body class="bg-slate-50 p-6">
    <div class="max-w-md mx-auto bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100">
        <div class="bg-[#1a365d] p-6 text-white text-center">
            <h1 class="text-xl font-bold">ตรวจสอบรายได้รายวัน</h1>
            <p class="text-xs opacity-70 mt-1">SN KOH LARN MANAGEMENT</p>
        </div>
        
        <div class="p-6 space-y-6">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">เลือกวันที่ต้องการตรวจสอบ</label>
                <input type="date" id="targetDate" class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-[#1a365d] outline-none">
            </div>
            
            <button onclick="fetchSummary()" id="btnFetch" class="w-full bg-[#1a365d] text-white py-4 rounded-xl font-bold hover:bg-navy-800 transition-all shadow-lg active:scale-95">
                📊 สรุปยอดทันที
            </button>

            <div id="resultArea" class="hidden space-y-4 pt-4 border-t border-dashed">
                <div class="flex justify-between items-center">
                    <span class="text-slate-500">จำนวนห้องที่ขายได้:</span>
                    <span id="roomCount" class="font-bold text-lg">-</span>
                </div>
                <div class="bg-slate-50 p-4 rounded-2xl text-center">
                    <p class="text-xs text-slate-400 uppercase tracking-widest mb-1">รายได้รวมทั้งหมด</p>
                    <p id="totalRevenue" class="text-3xl font-black text-[#1a365d]">฿0</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        const SCRIPT_URL = "URL_WEB_APP_ของคุณทนาย"; // ⚠️ วาง URL ของ Google Web App ตรงนี้ครับ

        async function fetchSummary() {
            const date = document.getElementById('targetDate').value;
            if(!date) return alert("กรุณาเลือกวันที่ก่อนครับคุณทนาย");
            
            const btn = document.getElementById('btnFetch');
            btn.innerText = "กำลังคำนวณ...";
            btn.disabled = true;

            try {
                const res = await fetch(SCRIPT_URL, {
                    method: 'POST',
                    body: JSON.stringify({ action: "getDailySummary", date: date })
                });
                const data = await res.json();
                
                if(data.status === "success") {
                    document.getElementById('resultArea').classList.remove('hidden');
                    document.getElementById('roomCount').innerText = data.roomCount + " ห้อง";
                    document.getElementById('totalRevenue').innerText = "฿" + data.totalRevenue.toLocaleString();
                }
            } catch (err) {
                alert("เกิดข้อผิดพลาดในการดึงข้อมูลครับ");
            } finally {
                btn.innerText = "📊 สรุปยอดทันที";
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
